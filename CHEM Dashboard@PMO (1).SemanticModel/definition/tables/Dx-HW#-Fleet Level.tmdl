				    #"Added Custom" = Table.AddColumn(#"Expanded Dx-HW#-Fleet Level, (BOM+Leaf) MSPNs+(PO# x BOM#)@FY20-25PO+BR UATs", "PartMSPN", each if [PartMSPN.1] = null or [PartMSPN.1] = "" then [MSPN] else [PartMSPN.1]),
