				    #"Renamed Columns" = Table.RenameColumns(#"Replaced Value",{{"MSPN", "BOM"}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Renamed Columns",{"MTCO2e_Spend", "PartMSPN.1"}),
				    #"Reordered Columns" = Table.ReorderColumns(#"Removed Columns",{"FiscalYear", "BOM", "POQuantity", "PartMSPN", "BOMQuantity"})
				in
